COMPOSE_PROJECT_NAME=infra-lab
TZ=Asia/Taipei

# Secrets
COMMON_PASSWORD=
KEYCLOAK_CLIENT_SECRET=change_me_in_production

# Versions
MSSQL_TAG=2025-CU1-ubuntu-24.04
REDIS_TAG=8.6.0-alpine
AZURITE_TAG=3.35.0
ELASTIC_VERSION=9.3.0
MOSQUITTO_TAG=2.0
RABBITMQ_TAG=4.0-management
SEARXNG_TAG=2026.1.30-ad42b553b
MAILPIT_TAG=v1.27
KEYCLOAK_TAG=26.5
SEQ_TAG=2025.2
UPTIME_KUMA_TAG=2
DOZZLE_TAG=v10.0.2
REDIS_EXPORTER_TAG=v1.80.2-alpine
REDIS_INSIGHT_TAG=3.0
INIT_PERMISSIONS_TAG=3
DOCKER_SOCKET_PROXY_TAG=v0.5.0
# 只用於 task mcp:build，以容器建置 MCP Server，主機不需安裝 .NET SDK
DOTNET_SDK_TAG=10.0

# Settings
# Datastores
MSSQL_PORT=1433
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
ES_PORT=9200
KIBANA_PORT=5601

# Messaging
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MOSQUITTO_PORT=1883
MOSQUITTO_WEB_PORT=9002

# Services
SEARXNG_PORT=8080
KEYCLOAK_PORT=8180

# Tools
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
SEQ_WEB_PORT=5340
SEQ_INGEST_PORT=5341
UPTIME_KUMA_PORT=3001
DOZZLE_PORT=8280
REDIS_EXPORTER_PORT=9121

# Network
# 所有對外 Port 綁定的位址。預設只允許本機存取。
# 多數服務共用同一組密碼，且部分管理介面無驗證；改成 0.0.0.0 前請先確認網路環境。
BIND_ADDR=127.0.0.1

# Resources (Memory Limit)
# 調整後可用 `task lab:mem` 檢查總額是否超過 Docker 可用記憶體。
SQL_MEM_LIMIT=2048M
ES_MEM_LIMIT=1536M
KIBANA_MEM_LIMIT=1024M
ELASTIC_SETUP_MEM_LIMIT=64M
REDIS_MEM_LIMIT=128M
REDIS_MAXMEMORY=64mb
REDISINSIGHT_MEM_LIMIT=256M
REDIS_EXPORTER_MEM_LIMIT=32M
AZURITE_MEM_LIMIT=192M
MOSQUITTO_MEM_LIMIT=32M
RABBITMQ_MEM_LIMIT=512M
KEYCLOAK_MEM_LIMIT=1360M
SEARXNG_MEM_LIMIT=256M
SEQ_MEM_LIMIT=768M
UPTIME_KUMA_MEM_LIMIT=256M
DOZZLE_MEM_LIMIT=64M
DOCKER_SOCKET_PROXY_MEM_LIMIT=32M
MAILPIT_MEM_LIMIT=64M
VSCODE_MEM_LIMIT=1024M
INIT_PERMISSIONS_MEM_LIMIT=32M

# Elastic
CLUSTER_NAME=docker-cluster
LICENSE=basic
